{
  "schema": 1,
  "id": "voice",
  "name": "DX Voice",
  "version": "0.6.0",
  "description": "DX Voice modules: Carbon Fluid Glass HUD, Ctrl dictation, workspace context index, optional screen-aware rewrite, Ctrl+Win commands, Alt+Win registered DX actions and dx v dashboard.",
  "author": "DX Voice contributors",
  "source": "https://github.com/soul667/dx-voice",
  "license": "MIT",
  "requires": {
    "remote_helper": ">=1.3,<2",
    "python": ">=3.10"
  },
  "entrypoints": {
    "cli": {
      "module": "dex_plugin.py",
      "function": "register_cli"
    }
  },
  "dependencies": {},
  "permissions": [
    "local.process",
    "local.files.read",
    "local.files.write",
    "network",
    "secrets",
    "x-microphone",
    "x-key-state",
    "x-clipboard",
    "x-pointer-state",
    "x-desktop-settings",
    "x-screen-capture"
  ],
  "commands": []
}
