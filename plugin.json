{
  "schema": 1,
  "id": "voice",
  "name": "DX Voice",
  "version": "0.2.1",
  "description": "Streaming voice input for Linux: hold Ctrl, speak, release. Standalone app and dx voice CLI.",
  "author": "DX Voice contributors",
  "source": "https://github.com/soul667/dx-voice",
  "license": "MIT",
  "requires": {
    "remote_helper": ">=1.3,<2",
    "python": ">=3.10"
  },
  "entrypoints": {
    "cli": {
      "module": "dex_plugin.py",
      "function": "register_cli"
    }
  },
  "dependencies": {},
  "permissions": [
    "local.process",
    "local.files.read",
    "local.files.write",
    "network",
    "secrets",
    "x-microphone",
    "x-key-state",
    "x-clipboard"
  ],
  "commands": []
}
